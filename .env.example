# Copy to .env (never committed) and fill in what you use. All optional.

# Claude Code, the default AI provider: run `claude setup-token` and paste the token here (Claude subscription),
# or set ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=

# Other providers (or type keys in Settings → AI providers, where they're kept in the library's .secrets.json).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# The port, on 127.0.0.1 (default 8765, the same as the Mac app's: pick another to run both).
# TKB_PORT=8766

# Where the library lives: a named volume by default. "." uses this folder's data/ and kb/ (never while the
# Mac app runs on them).
# TKB_LIBRARY=.
